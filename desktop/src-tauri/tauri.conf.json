{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperPasswdKey",
  "version": "0.3.0",
  "identifier": "com.superpasswdkey.spdesktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SuperPasswdKey",
        "width": 440,
        "height": 680,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
