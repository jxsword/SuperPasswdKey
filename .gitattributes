# 强制 LF（步骤 2 WSL/Linux 兼容，SP-C-105）
* text=auto eol=lf
*.rs text eol=lf diff=rust
*.toml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.ps1 text eol=lf
# Windows 批处理保持 CRLF（cmd 对 LF 有兼容坑；gradle wrapper 生成即 CRLF）
*.bat text eol=crlf
# 二进制例外
*.png binary
*.svg-files binary
*.exe binary
*.kdbx binary
